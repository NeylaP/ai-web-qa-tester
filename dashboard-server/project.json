{
  "name": "dashboard-server",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "dashboard-server/src",
  "projectType": "library",
  "tags": ["type:infrastructure", "scope:dashboard"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/dashboard-server",
        "main": "dashboard-server/src/index.ts",
        "tsConfig": "dashboard-server/tsconfig.lib.json"
      }
    }
  }
}
