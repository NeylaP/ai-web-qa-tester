{
  "name": "core-domain",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "core-domain/src",
  "projectType": "library",
  "tags": ["type:domain", "scope:core"],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../coverage/core-domain"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/core-domain",
        "main": "core-domain/src/index.ts",
        "tsConfig": "core-domain/tsconfig.lib.json",
        "assets": ["core-domain/*.md"]
      }
    }
  }
}
