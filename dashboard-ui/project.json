{
  "name": "dashboard-ui",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "dashboard-ui/src",
  "projectType": "application",
  "tags": ["type:app", "scope:dashboard"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/dashboard-ui"],
      "options": {
        "command": "npx vite build",
        "cwd": "dashboard-ui"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite",
        "cwd": "dashboard-ui"
      }
    }
  }
}
